# 物知学后端环境变量配置
# 复制此文件为 .env 并填入真实值

# ---------- AI API Keys ----------
MIMO_API_KEY=your_mimo_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---------- API Base URLs ----------
# MIMO_BASE_URL=https://api.mimo.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 应用配置 ----------
# DEBUG=true
# CORS_ORIGINS=["http://localhost:5173","https://wuzhixue.vercel.app"]

# ---------- Mock 模式 ----------
# MOCK_MODE=false   # 设为 true 时所有 AI 调用走 Mock，不消耗配额
